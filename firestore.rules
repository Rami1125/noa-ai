rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Generic rule for public data collections under the specific App ID
    match /artifacts/ai-studio-cc5d2687-b402-4b97-b808-5ba700689e0e/public/data/{collectionName}/{docId} {
      function isSignedIn() {
        return request.auth != null;
      }
      
      // WhatsApp Clone: For simplicity, allow authenticated users to read/write shared data
      // In production, we'd further restrict write access or filter reads by user context.
      allow read, write: if isSignedIn();
    }
  }
}
