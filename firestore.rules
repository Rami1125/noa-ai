rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared rule for Saban Dual-Bridge Architecture
    match /artifacts/{appId}/public/data/{collectionName} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isSaban() {
        return appId == "ai-studio-cc5d2687-b402-4b97-b808-5ba700689e0e" || appId == "saban-ai-drive";
      }
      
      allow read, write: if isSignedIn() && isSaban();

      match /{docId} {
        allow read, write: if isSignedIn() && isSaban();
      }
    }
  }
}
